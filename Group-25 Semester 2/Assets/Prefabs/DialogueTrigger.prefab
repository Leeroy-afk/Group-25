  m_Script: {fileID: 11500000, guid: a6db3b1d9838a1441bfb566ae7b493c5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 0}
  conversations:
  - lines:
    - speaker: Johny Sins
      portrait: {fileID: -1890486142, guid: 6db40329b1439d747bac3d49276457e7, type: 3}
      text: Hey there, this is a test for the dialogue system.
    - speaker: Johny Sins
      portrait: {fileID: -1890486142, guid: 6db40329b1439d747bac3d49276457e7, type: 3}
      text: 'You can navigate using WASD, go on walk around. '
    - speaker: Alice
      portrait: {fileID: 417084974, guid: 4ff5ba7fa4cf9ef4cbd01b144fe6e3aa, type: 3}
      text: Be careful, there's a big bad capsule lingering around here. Use F to
        shine your light and deter him away.
  - lines:
    - speaker: 'Alice '
      portrait: {fileID: 417084974, guid: 4ff5ba7fa4cf9ef4cbd01b144fe6e3aa, type: 3}
      text: Dont forget about me, I'm the patient.
    - speaker: Alice
      portrait: {fileID: 417084974, guid: 4ff5ba7fa4cf9ef4cbd01b144fe6e3aa, type: 3}
      text: Watch out for your sanity meter, if it drains both you and I are vulnerable
        to any attacks of the enemy.
