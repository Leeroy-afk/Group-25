    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: dialogueManager
      value: 
      objectReference: {fileID: 1068732459}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.data[0].text
      value: 'She has been unconcious for a while now.If I am being honest, I don''t
        think she will last long, each day she seems to be getting worse..  '
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.data[1].text
      value: Its a shame...
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.data[2].text
      value: 'Ha, Im reading this article written by this fanatic, "A World Beyond
        Sleep".  '
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.data[3].text
      value: 'Ha, Im reading this article written by this fanatic, "A World Beyond
        Sleep".  '
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.data[4].text
      value: '"There a beings in this world, which can transport people into a dreamlike
        place. '
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.data[5].text
      value: 'These being only appear to the sickly. My investigations have shown
        that when the person falls asleep some never awaken again. Are they trapping
        people in this world or are they providing comfort to them" .Can you imagine,
        this is why I like reading these things, it''s so interesting how people
        think. '
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.data[6].text
      value: I will leave you to it. Good luck
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.data[0].speaker
      value: Dr. Domicile
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.data[1].speaker
      value: Dr. Domicile
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.data[2].speaker
      value: Dr. Domicile
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
      propertyPath: conversations.Array.data[0].lines.Array.data[3].speaker
      value: Dr. Domicile
      objectReference: {fileID: 0}
    - target: {fileID: 8451805815172884903, guid: b25e08f8579e256468fee4ef832249d2, type: 3}
